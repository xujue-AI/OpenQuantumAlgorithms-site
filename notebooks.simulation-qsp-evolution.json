11-12T09:01:42.368789Z","shell.execute_reply":"2026-11-12T09:01:42.368036Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"accepted, acceptance = qe.postselected_evolution_state(circuit, initial)\nexact_state = expm(-1j*H) @ initial\nlabels = [f\"{i:03b}\" for i in range(8)]\nfig, axes = plt.subplots(1, 2, figsize=(10, 3.3))\npositions = np.arange(8)\nfor ax, part, name in [(axes[0], np.real, \"Real amplitude\"), (axes[1], np.imag, \"Imaginary amplitude\")]:\n    ax.bar(positions-.16, part(exact_state), width=.32, label=\"Exact exp(-iH)\", color=\"#b7c9d1\")\n    ax.bar(positions+.16, part(accepted), width=.32, label=\"Accepted QSP state\", color=\"#346b8a\", alpha=.8)\n    ax.set(xticks=positions, xticklabels=labels, xlabel=\"q2 q1 q0\", ylabel=name)\naxes[0].legend(fontsize=8)\nfig.tight_layout()\nplt.show()","identifier":"simulation-complex-qsp-state-code","enumerator":"3","html_id":"simulation-complex-qsp-state-code","key":"IgET7NEJTc"},{"type":"outputs","id":"ICYFTCBul5zqzZpfNFsOt","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"1210077e83c21aeff909b51914121243","path":"/OpenQuantumAlgorithms-site/_public/1210077e83c21aeff909b51914121243.png"},"text/plain":{"content":"<Figure size 1000x330 with 2 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"simulation-complex-qsp-state-outputs-0","html_id":"simulation-complex-qsp-state-outputs-0","key":"VsgLIsjlL7"}],"identifier":"simulation-complex-qsp-state-outputs","html_id":"simulation-complex-qsp-state-outputs","key":"EtAYZZsvif"}],"identifier":"simulation-complex-qsp-state","html_id":"simulation-complex-qsp-state","label":"simulation-complex-qsp-state","key":"qpOStvrZcy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Access, measurement and retries","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CkzX47QuqJ"}],"identifier":"access-measurement-and-retries","label":"Access, measurement and retries","html_id":"access-measurement-and-retries","implicit":true,"key":"weu85sSXVe"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The unitary generator supplies the coherent circuit. A measured trial appends final measurements on all wires; only outcomes with zero label/flag/selector bits are accepted, and the system bits supply the observable. All wires must be freshly initialized for each complete attempt. There is no amplitude amplification in this increment.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Qq3wz7BiPe"}],"key":"F5isBXMql1"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The ideal scaled-unitary acceptance is 1/16. The phase error checks and finite-H singular values are numerical evidence; neither is a formal acceptance certificate. Restart and observable-shot proposals stay conditional on their stated acceptance/synthesis assumptions. Statistical confidence and physical-fault confidence are separate.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"CHRNuEFJhB"}],"key":"xywG13gSIp"}],"identifier":"b18b0875","html_id":"b18b0875","key":"G3q7NUtm3x"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-12T09:01:42.370305Z","iopub.status.busy":"2026-11-12T09:01:42.370155Z","iopub.status.idle":"2026-11-12T09:01:42.456552Z","shell.execute_reply":"2026-11-12T09:01:42.455790Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"compiled = hs.decompose(circuit)\nmeasured = compiled.copy()\nmeasured.measure_all()\ncounts = dict(measured.count_ops())\ndisplay(pd.DataFrame([{\"operation\": gate, \"count per complete measured trial\": count} for gate, count in counts.items()]))\nprint(\"Primitive dependency depth:\", measured.depth())\nprint(\"Conditionally proposed cap for one accepted measured trial at 99% acceptance:\", contract[\"complete_attempts_for_conditional_acceptance_projection\"])\nprint(\"All phase/acceptance projections certified:\", contract[\"certified\"])","identifier":"simulation-complex-qsp-ledger-code","enumerator":"4","html_id":"simulation-complex-qsp-ledger-code","key":"vnJq3P7Ix8"},{"type":"outputs","id":"5GklC23JrNje_C_BCd2CC","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>operation</th>\n      <th>count per complete measured trial</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>cx</td>\n      <td>3770</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>rz</td>\n      <td>2063</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>t</td>\n      <td>873</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>tdg</td>\n      <td>774</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>ry</td>\n      <td>630</td>\n    </tr>\n    <tr>\n      <th>5</th>\n      <td>h</td>\n      <td>240</td>\n    </tr>\n    <tr>\n      <th>6</th>\n      <td>x</td>\n      <td>203</td>\n    </tr>\n    <tr>\n      <th>7</th>\n      <td>rx</td>\n      <td>186</td>\n    </tr>\n    <tr>\n      <th>8</th>\n      <td>measure</td>\n      <td>8</td>\n    </tr>\n    <tr>\n      <th>9</th>\n      <td>sdg</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>10</th>\n      <td>barrier</td>\n      <td>1</td>\n    </tr>\n  </tbody>\n</table>\n</div>","content_type":"text/html"},"text/plain":{"content":"   operation  count per complete measured trial\n0         cx                               3770\n1         rz                               2063\n2          t                                873\n3        tdg                                774\n4         ry                                630\n5          h                                240\n6          x                                203\n7         rx                                186\n8    measure                                  8\n9        sdg                                  1\n10   barrier                                  1","content_type":"text/plain"}}},"children":[],"identifier":"simulation-complex-qsp-ledger-outputs-0","html_id":"simulation-complex-qsp-ledger-outputs-0","key":"eiOQLbVPmu"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Primitive dependency depth: 6659\nConditionally proposed cap for one accepted measured trial at 99% acceptance: 72\nAll phase/acceptance projections certified: False\n"},"children":[],"identifier":"simulation-complex-qsp-ledger-outputs-1","html_id":"simulation-complex-qsp-ledger-outputs-1","key":"rbOpXuOGgU"}],"identifier":"simulation-complex-qsp-ledger-outputs","html_id":"simulation-complex-qsp-ledger-outputs","key":"Lx7TMwvUTV"}],"identifier":"simulation-complex-qsp-ledger","html_id":"simulation-complex-qsp-ledger","label":"simulation-complex-qsp-ledger","key":"xr6NEorIgJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Reproduction and limits","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hAWeLChBl5"}],"identifier":"reproduction-and-limits","label":"Reproduction and limits","html_id":"reproduction-and-limits","implicit":true,"key":"DgAAV7uY9n"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The source/generator records frozen cosine and sine phases and their deterministic bounded fits. The default build verifies frozen phases without launching the slower optional optimizer. A requested alpha*time inconsistent with supplied phases is rejected; other times require independently verified phases.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Q5w3g7EFCY"}],"key":"dOymL3PTJg"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Dense full-Operator checks are capped at eight total wires; statevector checks at twelve. The materialized generator separately caps Pauli terms, system width, phase degree and source operations. These checks do not establish scalable black-box Hamiltonian access or a hardware speedup. Arbitrary rotation synthesis, physical error correction and deterministic/amplified evolution remain pending. The shared resource specialist must use a postselection-aware precision/workload contract.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"qGlh70yqHG"}],"key":"EohrjY0841"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Original MIT modules use Qiskit 2.6.2 (Apache-2.0) and SciPy 1.18.1 (BSD-3-Clause). Primary QSP/qubitization/LCU references and exact upstream attribution are on the dynamics page. No widget state or private server is required for the saved outputs.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"YDNkaCTgDK"}],"key":"BBz9wMJIN4"}],"identifier":"797bc596","html_id":"797bc596","key":"Un3cNm0X1z"}],"key":"nxY3MiuVOb"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"A small quantum signal-processing circuit","short_title":"Small QSP circuit","url":"/notebooks/qsp-basics","group":"Open Quantum Algorithms"},"next":{"title":"Oblivious amplification of complex dynamics","url":"/algorithms/simulation/amplification","group":"Open Quantum Algorithms"}}},"domain":"http://pre.render"}