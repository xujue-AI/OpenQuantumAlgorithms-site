xists():\n    root = root.parent\nif (root / \"src\").exists():\n    sys.path.insert(0, str(root / \"src\"))\nfrom openquantum.shor import (\n    build_order_finding_circuit, decompose, simulate_phase_distribution,\n    success_contract, reconstruct_order, factors_from_order,\n    controlled_multiplier_gate, modular_adder_gate,\n)\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom qiskit import QuantumCircuit\nfrom qiskit.quantum_info import Statevector\n","key":"jsIPTh2OJ5"},{"type":"outputs","id":"z9yB8QdIFUFRu0Z8PcrWu","children":[],"key":"DbPInreOtO"}],"identifier":"187e64f9","html_id":"187e64f9","key":"RQm7VdIB6K"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Circuit: N=15, a=2, t=4","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"g8M7KS1P1h"}],"identifier":"circuit-n-15-a-2-t-4","label":"Circuit: N=15, a=2, t=4","html_id":"circuit-n-15-a-2-t-4","implicit":true,"key":"zi4wDYhsvg"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"All multiplier boxes have actual gate definitions. The code chooses constants with modular exponentiation and never looks up the order to construct the circuit. Four exponent bits are a favorable small-instance precision, distinct from generic t=2n. Work wires start at zero.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OF4iEIRzsJ"}],"key":"NBrxjNWifB"}],"identifier":"5252440b","html_id":"5252440b","key":"RcCOP0YsId"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-12T08:48:51.007052Z","iopub.status.busy":"2026-11-12T08:48:51.006781Z","iopub.status.idle":"2026-11-12T08:48:51.238151Z","shell.execute_reply":"2026-11-12T08:48:51.237515Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"N, a, t = 15, 2, 4\ncircuit = build_order_finding_circuit(N, a, t)\ncircuit.draw(output=\"mpl\", fold=36, scale=0.8)","identifier":"shor-circuit-code","enumerator":"1","html_id":"shor-circuit-code","key":"xIXUJOdf4f"},{"type":"outputs","id":"6b3swIZvUlkfhxtplNW2e","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":2,"metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"93eb29d3c1bac671842380ed89f61eec","path":"/OpenQuantumAlgorithms-site/_public/93eb29d3c1bac671842380ed89f61eec.png"},"text/plain":{"content":"<Figure size 445.248x963.2 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"shor-circuit-outputs-0","html_id":"shor-circuit-outputs-0","key":"eD5HriyIW6"}],"identifier":"shor-circuit-outputs","html_id":"shor-circuit-outputs","key":"rAiL3IdvVR"}],"identifier":"shor-circuit","html_id":"shor-circuit","label":"shor-circuit","key":"LpwWAkSbrg"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-12T08:48:51.239439Z","iopub.status.busy":"2026-11-12T08:48:51.239289Z","iopub.status.idle":"2026-11-12T08:48:51.622106Z","shell.execute_reply":"2026-11-12T08:48:51.620995Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"result = simulate_phase_distribution(N, a, t)\nassert result[\"max_probability_error\"] < 1e-10\nassert result[\"work_register_zero_probability\"] > 1 - 1e-10\n{key: result[key] for key in (\"classical_reference_order\", \"max_probability_error\", \"work_register_zero_probability\", \"total_qubits\")}","identifier":"shor-results-code","enumerator":"2","html_id":"shor-results-code","key":"IbEBrLCm5e"},{"type":"outputs","id":"KItdmKLRAGrUuU2vLhp2g","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":3,"metadata":{},"data":{"text/plain":{"content":"{'classical_reference_order': 4,\n 'max_probability_error': 2.223221606811876e-14,\n 'work_register_zero_probability': 0.9999999999999111,\n 'total_qubits': 14}","content_type":"text/plain"}}},"children":[],"identifier":"shor-results-outputs-0","html_id":"shor-results-outputs-0","key":"ncpFcumFhZ"}],"identifier":"shor-results-outputs","html_id":"shor-results-outputs","key":"qROmtknoyu"}],"identifier":"shor-results","html_id":"shor-results","label":"shor-results","key":"HvcGPwam7u"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-12T08:48:51.624653Z","iopub.status.busy":"2026-11-12T08:48:51.624128Z","iopub.status.idle":"2026-11-12T08:48:51.729626Z","shell.execute_reply":"2026-11-12T08:48:51.729028Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"ys = np.arange(1 << t)\nplt.bar(ys, result[\"probabilities\"], label=\"actual arithmetic circuit\", color=\"#287e83\")\nplt.plot(ys, result[\"reference_probabilities\"], \".\", label=\"independent Fourier sum\", color=\"#dc7b4e\")\nplt.xlabel(\"Exponent measurement y\")\nplt.ylabel(\"Ideal probability\")\nplt.legend()\nplt.tight_layout()\nplt.show()","identifier":"shor-probabilities-code","enumerator":"3","html_id":"shor-probabilities-code","key":"nlFnKw403B"},{"type":"outputs","id":"woCdKXkVh_8fTmsHvOeGF","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"ff28c2ec02568456d63522fd9b6daf6e","path":"/OpenQuantumAlgorithms-site/_public/ff28c2ec02568456d63522fd9b6daf6e.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"shor-probabilities-outputs-0","html_id":"shor-probabilities-outputs-0","key":"bYLBi62jAP"}],"identifier":"shor-probabilities-outputs","html_id":"shor-probabilities-outputs","key":"stZSdtqVau"}],"identifier":"shor-probabilities","html_id":"shor-probabilities","label":"shor-probabilities","key":"N55ApHv4Nt"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Classical reconstruction and all repetitions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"M4Q0vaK93p"}],"identifier":"classical-reconstruction-and-all-repetitions","label":"Classical reconstruction and all repetitions","html_id":"classical-reconstruction-and-all-repetitions","implicit":true,"key":"ZKgqqTKEDU"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Convergent denominators are verified by modular exponentiation. A valid period can be a multiple of the minimal order at finite precision; gcd outputs are always checked. Neither classical order enumeration nor trial division is used in reconstruction. The separate enumerated order is an independent bounded validation reference.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FaVFPC4AFk"}],"key":"datcSRu9hz"}],"identifier":"ea68a1b7","html_id":"ea68a1b7","key":"OQT3qb5d1W"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-12T08:48:51.731000Z","iopub.status.busy":"2026-11-12T08:48:51.730834Z","iopub.status.idle":"2026-11-12T08:48:51.736703Z","shell.execute_reply":"2026-11-12T08:48:51.736219Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"contract = success_contract(N, a, t)\nassert contract[\"ideal_factoring_success_probability_per_trial\"] == 0.5\nassert contract[\"serial_trials\"] == 8\nrng = np.random.default_rng(20261112)\np = np.array(result[\"probabilities\"])\np /= p.sum()\noutcomes = rng.choice(1 << t, size=contract[\"serial_trials\"], p=p)\nrecords = []\nfor y in outcomes:\n    period = reconstruct_order(int(y), t, N, a)\n    factors = factors_from_order(N, a, period)\n    assert all(1 < factor < N and N % factor == 0 for factor in factors)\n    records.append({\"outcome\": int(y), \"verified_period\": period, \"factors\": factors})\nrecords","identifier":"shor-samples-code","enumerator":"4","html_id":"shor-samples-code","key":"CIO8Gw434r"},{"type":"outputs","id":"kI7GDK9zpLkmnhFwVkpAk","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{},"data":{"text/plain":{"content":"[{'outcome': 12, 'verified_period': 4, 'factors': [3, 5]},\n {'outcome': 0, 'verified_period': None, 'factors': []},\n {'outcome': 4, 'verified_period': 4, 'factors': [3, 5]},\n {'outcome': 12, 'verified_period': 4, 'factors': [3, 5]},\n {'outcome': 0, 'verified_period': None, 'factors': []},\n {'outcome': 4, 'verified_period': 4, 'factors': [3, 5]},\n {'outcome': 4, 'verified_period': 4, 'factors': [3, 5]},\n {'outcome': 8, 'verified_period': None, 'factors': []}]","content_type":"text/plain"}}},"children":[],"identifier":"shor-samples-outputs-0","html_id":"shor-samples-outputs-0","key":"l8ZgKwCCtW"}],"identifier":"shor-samples-outputs","html_id":"shor-samples-outputs","key":"Q0gOELBrc0"}],"identifier":"shor-samples","html_id":"shor-samples","label":"shor-samples","key":"iTK61cgan6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Less favorable nonexact phase: N=21, a=2, t=6","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"p2uBotwE9i"}],"identifier":"less-favorable-nonexact-phase-n-21-a-2-t-6","label":"Less favorable nonexact phase: N=21, a=2, t=6","html_id":"less-favorable-nonexact-phase-n-21-a-2-t-6","implicit":true,"key":"tDcB8xs6hr"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The order is six, which does not divide the Fourier grid size 64. Actual circuit probabilities are compared with the independent finite Fourier sum; the ideal verified-factor probability includes unsuccessful outcomes.","position