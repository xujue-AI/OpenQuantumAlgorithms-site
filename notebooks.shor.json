t\nif (root / \"src\").exists():\n    sys.path.insert(0, str(root / \"src\"))\nfrom openquantum.shor import (\n    build_order_finding_circuit, decompose, simulate_phase_distribution,\n    success_contract, reconstruct_order, factors_from_order,\n    controlled_multiplier_gate, modular_adder_gate,\n)\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom qiskit import QuantumCircuit\nfrom qiskit.quantum_info import Statevector\n","key":"ybshmvAxMK"},{"type":"outputs","id":"77cae-n485Z7hWQkNgkRS","children":[],"key":"pFBjPGtX7z"}],"identifier":"187e64f9","html_id":"187e64f9","key":"ik03yHhZh0"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Circuit: N=15, a=2, t=4","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jk00UjsJu6"}],"identifier":"circuit-n-15-a-2-t-4","label":"Circuit: N=15, a=2, t=4","html_id":"circuit-n-15-a-2-t-4","implicit":true,"key":"VZPXoxIADT"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"All multiplier boxes have actual gate definitions. The code chooses constants with modular exponentiation and never looks up the order to construct the circuit. Four exponent bits are a favorable small-instance precision, distinct from generic t=2n. Work wires start at zero.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"nlfY4s6mmW"}],"key":"zbmEdrEojV"}],"identifier":"5252440b","html_id":"5252440b","key":"NYBrBLTU2l"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-14T07:14:27.194553Z","iopub.status.busy":"2026-11-14T07:14:27.194288Z","iopub.status.idle":"2026-11-14T07:14:27.738249Z","shell.execute_reply":"2026-11-14T07:14:27.737309Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"N, a, t = 15, 2, 4\ncircuit = build_order_finding_circuit(N, a, t)\ncircuit.draw(output=\"mpl\", fold=36, scale=0.8)","identifier":"shor-circuit-code","enumerator":"1","html_id":"shor-circuit-code","key":"woBHOuCWBf"},{"type":"outputs","id":"1zEU9GhkCEPG-BzaQFTsO","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":2,"metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"93eb29d3c1bac671842380ed89f61eec","path":"/OpenQuantumAlgorithms-site/_public/93eb29d3c1bac671842380ed89f61eec.png"},"text/plain":{"content":"<Figure size 445.248x963.2 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"shor-circuit-outputs-0","html_id":"shor-circuit-outputs-0","key":"RSa1ZIW75y"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"93eb29d3c1bac671842380ed89f61eec","path":"/OpenQuantumAlgorithms-site/_public/93eb29d3c1bac671842380ed89f61eec.png"},"text/plain":{"content":"<Figure size 445.248x963.2 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"shor-circuit-outputs-1","html_id":"shor-circuit-outputs-1","key":"aMWqvZdp7Y"}],"identifier":"shor-circuit-outputs","html_id":"shor-circuit-outputs","key":"kA7QZexWix"}],"identifier":"shor-circuit","html_id":"shor-circuit","label":"shor-circuit","key":"K4AjFQ0abY"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-14T07:14:27.739886Z","iopub.status.busy":"2026-11-14T07:14:27.739671Z","iopub.status.idle":"2026-11-14T07:14:28.611175Z","shell.execute_reply":"2026-11-14T07:14:28.609882Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"result = simulate_phase_distribution(N, a, t)\nassert result[\"max_probability_error\"] < 1e-10\nassert result[\"work_register_zero_probability\"] > 1 - 1e-10\n{key: result[key] for key in (\"classical_reference_order\", \"max_probability_error\", \"work_register_zero_probability\", \"total_qubits\")}","identifier":"shor-results-code","enumerator":"2","html_id":"shor-results-code","key":"CweZq2dG2J"},{"type":"outputs","id":"IA9P3QSl76xl5e2i4klkF","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":3,"metadata":{},"data":{"text/plain":{"content":"{'classical_reference_order': 4,\n 'max_probability_error': 2.223221606811876e-14,\n 'work_register_zero_probability': 0.9999999999999111,\n 'total_qubits': 14}","content_type":"text/plain"}}},"children":[],"identifier":"shor-results-outputs-0","html_id":"shor-results-outputs-0","key":"ZBap4XGpKy"}],"identifier":"shor-results-outputs","html_id":"shor-results-outputs","key":"owEdpTmjNn"}],"identifier":"shor-results","html_id":"shor-results","label":"shor-results","key":"FPwgFjFd1D"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-14T07:14:28.613459Z","iopub.status.busy":"2026-11-14T07:14:28.612786Z","iopub.status.idle":"2026-11-14T07:14:28.783141Z","shell.execute_reply":"2026-11-14T07:14:28.781874Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"ys = np.arange(1 << t)\nplt.bar(ys, result[\"probabilities\"], label=\"actual arithmetic circuit\", color=\"#287e83\")\nplt.plot(ys, result[\"reference_probabilities\"], \".\", label=\"independent Fourier sum\", color=\"#dc7b4e\")\nplt.xlabel(\"Exponent measurement y\")\nplt.ylabel(\"Ideal probability\")\nplt.legend()\nplt.tight_layout()\nplt.show()","identifier":"shor-probabilities-code","enumerator":"3","html_id":"shor-probabilities-code","key":"J1SeQ3JgFF"},{"type":"outputs","id":"WZ0g0n9ZfPWKos52XjY-p","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"ff28c2ec02568456d63522fd9b6daf6e","path":"/OpenQuantumAlgorithms-site/_public/ff28c2ec02568456d63522fd9b6daf6e.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"shor-probabilities-outputs-0","html_id":"shor-probabilities-outputs-0","key":"neQ8XgcoPv"}],"identifier":"shor-probabilities-outputs","html_id":"shor-probabilities-outputs","key":"ddgSLY8ADD"}],"identifier":"shor-probabilities","html_id":"shor-probabilities","label":"shor-probabilities","key":"Sd8OUeGbkG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Classical reconstruction and all repetitions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vW9IV8JjC2"}],"identifier":"classical-reconstruction-and-all-repetitions","label":"Classical reconstruction and all repetitions","html_id":"classical-reconstruction-and-all-repetitions","implicit":true,"key":"zGhnnp3fYJ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Convergent denominators are verified by modular exponentiation. A valid period can be a multiple of the minimal order at finite precision; gcd outputs are always checked. Neither classical order enumeration nor trial division is used in reconstruction. The separate enumerated order is an independent bounded validation reference.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IemaHO74PX"}],"key":"jwyLjEdcaL"}],"identifier":"ea68a1b7","html_id":"ea68a1b7","key":"bvlebADc7u"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-14T07:14:28.785052Z","iopub.status.busy":"2026-11-14T07:14:28.784819Z","iopub.status.idle":"2026-11-14T07:14:28.793527Z","shell.execute_reply":"2026-11-14T07:14:28.792347Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"contract = success_contract(N, a, t)\nassert contract[\"ideal_factoring_success_probability_per_trial\"] == 0.5\nassert contract[\"serial_trials\"] == 8\nrng = np.random.default_rng(20261112)\np = np.array(result[\"probabilities\"])\np /= p.sum()\noutcomes = rng.choice(1 << t, size=contract[\"serial_trials\"], p=p)\nrecords = []\nfor y in outcomes:\n    period = reconstruct_order(int(y), t, N, a)\n    factors = factors_from_order(N, a, period)\n    assert all(1 < factor < N and N % factor == 0 for factor in factors)\n    records.append({\"outcome\": int(y), \"verified_period\": period, \"factors\": factors})\nrecords","identifier":"shor-samples-code","enumerator":"4","html_id":"shor-samples-code","key":"B57NwXJMn8"},{"type":"outputs","id":"yimxPUFySmLzqsYLH6__q","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{},"data":{"text/plain":{"content":"[{'outcome': 12, 'verified_period': 4, 'factors': [3, 5]},\n {'outcome': 0, 'verified_period': None, 'factors': []},\n {'outcome': 4, 'verified_period': 4, 'factors': [3, 5]},\n {'outcome': 12, 'verified_period': 4, 'factors': [3, 5]},\n {'outcome': 0, 'verified_period': None, 'factors': []},\n {'outcome': 4, 'verified_period': 4, 'factors': [3, 5]},\n {'outcome': 4, 'verified_period': 4, 'factors': [3, 5]},\n {'outcome': 8, 'verified_period': None, 'factors': []}]","content_type":"text/plain"}}},"children":[],"identifier":"shor-samples-outputs-0","html_id":"shor-samples-outputs-0","key":"LeCyihKQ37"}],"identifier":"shor-samples-outputs","html_id":"shor-samples-outputs","key":"xLhCs3OlR7"}],"identifier":"shor-samples","html_id":"shor-samples","label":"shor-samples","key":"BELdoKHXL2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Less favorable nonexact phase: N=21, a=2, t=6","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oDZWnrx7AE"}],"identifier":"less-favorable-nonexact-phase-n-21-a-2-t-6","label":"Less favorable nonexact phase: N=21, a=2, t=6","html_id":"less-favorable-nonexact-phase-n-21-a-2-t-6","implicit":true,"key":"wTtHd0MxT8"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The order is six, which does not divide the Fourier grid size 64. Actual circuit probabilities are compared with the independent finite Fourier sum; the ideal verified-factor probability includes unsuccessful outcomes.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"L0TmZVj77b"}],"key":"k61Uf3q72f"}],"identifier":"e1e3a733","html_id":"e1e3a733","key":"OxLSlU6Eog"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-14T07:14:28.795367Z","iopub.status.busy":"2026-11-14T07:14:28.795183Z","iopub.status.idle":"2026-11-14T07:15:29.970546Z","shell.execute_reply":"2026-11-14T07:15:29.969674Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"second = simulate_phase_distribution(21, 2, 6)\nsecond_contract = success_contract(21, 2, 6)\nassert second[\"max_probability_error\"] < 1e-10\nassert second_contract[\"serial_trials\"] == 16\n{\"probability_error\": second[\"max_probability_error\"],\n \"clean_work_probability\": second[\"work_register_zero_probability\"],\n \"ideal_factor_success_per_trial\": second_contract[\"ideal_factoring_success_probability_per_trial\"],\n \"trials_for_0.005_ideal_sampling_failure\": second_contract[\"serial_trials\"]}","identifier":"shor-second-instance-code","enumerator":"5","html_id":"shor-second-instance-code","key":"cYbgXvZtEd"},{"type":"outputs","id":"3QvpckGF3LNL75LNYe821","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":6,"metadata":{},"data":{"text/plain":{"content":"{'probability_error': 6.997180612700049e-14,\n 'clean_work_probability': 0.999999999999581,\n 'ideal_factor_success_per_trial': 0.28798913703656037,\n 'trials_for_0.005_ideal_sampling_failure': 16}","content_type":"text/plain"}}},"children":[],"identi