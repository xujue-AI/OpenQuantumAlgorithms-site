t\nif (root / \"src\").exists():\n    sys.path.insert(0, str(root / \"src\"))\nfrom openquantum.shor import (\n    build_order_finding_circuit, decompose, simulate_phase_distribution,\n    success_contract, reconstruct_order, factors_from_order,\n    controlled_multiplier_gate, modular_adder_gate,\n)\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom qiskit import QuantumCircuit\nfrom qiskit.quantum_info import Statevector\n","key":"f5sUFRiofm"},{"type":"outputs","id":"H_ypZR15BQcWQyp5Sjdp7","children":[],"key":"LYjoBstYQs"}],"identifier":"187e64f9","html_id":"187e64f9","key":"kt4lFCC6Jc"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Circuit: N=15, a=2, t=4","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jmBMh3fnpN"}],"identifier":"circuit-n-15-a-2-t-4","label":"Circuit: N=15, a=2, t=4","html_id":"circuit-n-15-a-2-t-4","implicit":true,"key":"JF9HPFG1lc"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"All multiplier boxes have actual gate definitions. The code chooses constants with modular exponentiation and never looks up the order to construct the circuit. Four exponent bits are a favorable small-instance precision, distinct from generic t=2n. Work wires start at zero.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uJ6NkZrVHJ"}],"key":"XT76eKnGRa"}],"identifier":"5252440b","html_id":"5252440b","key":"LcXtUeLNqW"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-14T17:05:56.689396Z","iopub.status.busy":"2026-11-14T17:05:56.689088Z","iopub.status.idle":"2026-11-14T17:05:57.246234Z","shell.execute_reply":"2026-11-14T17:05:57.245130Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"N, a, t = 15, 2, 4\ncircuit = build_order_finding_circuit(N, a, t)\ncircuit.draw(output=\"mpl\", fold=36, scale=0.8)","identifier":"shor-circuit-code","enumerator":"1","html_id":"shor-circuit-code","key":"Z7k7GPwcQe"},{"type":"outputs","id":"CIRnHsbNJuiYnxPLSvcTm","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":2,"metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"93eb29d3c1bac671842380ed89f61eec","path":"/OpenQuantumAlgorithms-site/_public/93eb29d3c1bac671842380ed89f61eec.png"},"text/plain":{"content":"<Figure size 445.248x963.2 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"shor-circuit-outputs-0","html_id":"shor-circuit-outputs-0","key":"YAiZyejTTq"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"93eb29d3c1bac671842380ed89f61eec","path":"/OpenQuantumAlgorithms-site/_public/93eb29d3c1bac671842380ed89f61eec.png"},"text/plain":{"content":"<Figure size 445.248x963.2 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"shor-circuit-outputs-1","html_id":"shor-circuit-outputs-1","key":"Qu2bG8ekfb"}],"identifier":"shor-circuit-outputs","html_id":"shor-circuit-outputs","key":"I92Eo1al8f"}],"identifier":"shor-circuit","html_id":"shor-circuit","label":"shor-circuit","key":"Uuse2FxslR"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-14T17:05:57.248325Z","iopub.status.busy":"2026-11-14T17:05:57.248093Z","iopub.status.idle":"2026-11-14T17:05:58.125260Z","shell.execute_reply":"2026-11-14T17:05:58.124502Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"result = simulate_phase_distribution(N, a, t)\nassert result[\"max_probability_error\"] < 1e-10\nassert result[\"work_register_zero_probability\"] > 1 - 1e-10\n{key: result[key] for key in (\"classical_reference_order\", \"max_probability_error\", \"work_register_zero_probability\", \"total_qubits\")}","identifier":"shor-results-code","enumerator":"2","html_id":"shor-results-code","key":"CUjPyzj7Mz"},{"type":"outputs","id":"Njvw7xLgxRHgcbPwfQhsm","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":3,"metadata":{},"data":{"text/plain":{"content":"{'classical_reference_order': 4,\n 'max_probability_error': 2.223221606811876e-14,\n 'work_register_zero_probability': 0.9999999999999111,\n 'total_qubits': 14}","content_type":"text/plain"}}},"children":[],"identifier":"shor-results-outputs-0","html_id":"shor-results-outputs-0","key":"S5hYhlsFbZ"}],"identifier":"shor-results-outputs","html_id":"shor-results-outputs","key":"iG4e0D9Aob"}],"identifier":"shor-results","html_id":"shor-results","label":"shor-results","key":"VnWz2VgpNE"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-14T17:05:58.127598Z","iopub.status.busy":"2026-11-14T17:05:58.127383Z","iopub.status.idle":"2026-11-14T17:05:58.302206Z","shell.execute_reply":"2026-11-14T17:05:58.301127Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"ys = np.arange(1 << t)\nplt.bar(ys, result[\"probabilities\"], label=\"actual arithmetic circuit\", color=\"#287e83\")\nplt.plot(ys, result[\"reference_probabilities\"], \".\", label=\"independent Fourier sum\", color=\"#dc7b4e\")\nplt.xlabel(\"Exponent measurement y\")\nplt.ylabel(\"Ideal probability\")\nplt.legend()\nplt.tight_layout()\nplt.show()","identifier":"shor-probabilities-code","enumerator":"3","html_id":"shor-probabilities-code","key":"UOgczXURDs"},{"type":"outputs","id":"8m5irKTPJp5koNFGGnCjM","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"ff28c2ec02568456d63522fd9b6daf6e","path":"/OpenQuantumAlgorithms-site/_public/ff28c2ec02568456d63522fd9b6daf6e.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"shor-probabilities-outputs-0","html_id":"shor-probabilities-outputs-0","key":"lRl78oVXKU"}],"identifier":"shor-probabilities-outputs","html_id":"shor-probabilities-outputs","key":"Y7SjNmX0qg"}],"identifier":"shor-probabilities","html_id":"shor-probabilities","label":"shor-probabilities","key":"XPCWaGKG9P"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Classical reconstruction and all repetitions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vdVlORU6e3"}],"identifier":"classical-reconstruction-and-all-repetitions","label":"Classical reconstruction and all repetitions","html_id":"classical-reconstruction-and-all-repetitions","implicit":true,"key":"QPasYvMdGE"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Convergent denominators are verified by modular exponentiation. A valid period can be a multiple of the minimal order at finite precision; gcd outputs are always checked. Neither classical order enumeration nor trial division is used in reconstruction. The separate enumerated order is an independent bounded validation reference.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jfltr3nXgk"}],"key":"tLNls21MHZ"}],"identifier":"ea68a1b7","html_id":"ea68a1b7","key":"y5w31VnR6e"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-14T17:05:58.304046Z","iopub.status.busy":"2026-11-14T17:05:58.303846Z","iopub.status.idle":"2026-11-14T17:05:58.311875Z","shell.execute_reply":"2026-11-14T17:05:58.311090Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"contract = success_contract(N, a, t)\nassert contract[\"ideal_factoring_success_probability_per_trial\"] == 0.5\nassert contract[\"serial_trials\"] == 8\nrng = np.random.default_rng(20261112)\np = np.array(result[\"probabilities\"])\np /= p.sum()\noutcomes = rng.choice(1 << t, size=contract[\"serial_trials\"], p=p)\nrecords = []\nfor y in outcomes:\n    period = reconstruct_order(int(y), t, N, a)\n    factors = factors_from_order(N, a, period)\n    assert all(1 < factor < N and N % factor == 0 for factor in factors)\n    records.append({\"outcome\": int(y), \"verified_period\": period, \"factors\": factors})\nrecords","identifier":"shor-samples-code","enumerator":"4","html_id":"shor-samples-code","key":"xJJOwwQcM4"},{"type":"outputs","id":"ylJ0F7Rth_rDZsYRkFSnu","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{},"data":{"text/plain":{"content":"[{'outcome': 12, 'verified_period': 4, 'factors': [3, 5]},\n {'outcome': 0, 'verified_period': None, 'factors': []},\n {'outcome': 4, 'verified_period': 4, 'factors': [3, 5]},\n {'outcome': 12, 'verified_period': 4, 'factors': [3, 5]},\n {'outcome': 0, 'verified_period': None, 'factors': []},\n {'outcome': 4, 'verified_period': 4, 'factors': [3, 5]},\n {'outcome': 4, 'verified_period': 4, 'factors': [3, 5]},\n {'outcome': 8, 'verified_period': None, 'factors': []}]","content_type":"text/plain"}}},"children":[],"identifier":"shor-samples-outputs-0","html_id":"shor-samples-outputs-0","key":"WpmnqtHg97"}],"identifier":"shor-samples-outputs","html_id":"shor-samples-outputs","key":"u1T3BjaAVV"}],"identifier":"shor-samples","html_id":"shor-samples","label":"shor-samples","key":"gK7NxaXtbP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Less favorable nonexact phase: N=21, a=2, t=6","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Tp8vHNTL23"}],"identifier":"less-favorable-nonexact-phase-n-21-a-2-t-6","label":"Less favorable nonexact phase: N=21, a=2, t=6","html_id":"less-favorable-nonexact-phase-n-21-a-2-t-6","implicit":true,"key":"vJZgpzOqdW"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The order is six, which does not divide the Fourier grid size 64. Actual circuit probabilities are compared with the independent finite Fourier sum; the ideal verified-factor probability includes unsuccessful outcomes.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lHkEjxpafb"}],"key":"Dhx6qDuO6H"}],"identifier":"e1e3a733","html_id":"e1e3a733","key":"Oj9hxNUsHi"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-14T17:05:58.314004Z","iopub.status.busy":"2026-11-14T17:05:58.313814Z","iopub.status.idle":"2026-11-14T17:06:59.441789Z","shell.execute_reply":"2026-11-14T17:06:59.440461Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"second = simulate_phase_distribution(21, 2, 6)\nsecond_contract = success_contract(21, 2, 6)\nassert second[\"max_probability_error\"] < 1e-10\nassert second_contract[\"serial_trials\"] == 16\n{\"probability_error\": second[\"max_probability_error\"],\n \"clean_work_probability\": second[\"work_register_zero_probability\"],\n \"ideal_factor_success_per_trial\": second_contract[\"ideal_factoring_success_probability_per_trial\"],\n \"trials_for_0.005_ideal_sampling_failure\": second_contract[\"serial_trials\"]}","identifier":"shor-second-instance-code","enumerator":"5","html_id":"shor-second-instance-code","key":"u24DxtWJbz"},{"type":"outputs","id":"aM2rfb6jBbmcvH4ag8uHI","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":6,"metadata":{},"data":{"text/plain":{"content":"{'probability_error': 6.997180612700049e-14,\n 'clean_work_probability': 0.999999999999581,\n 'ideal_factor_success_per_trial': 0.28798913703656037,\n 'trials_for_0.005_ideal_sampling_failure': 16}","content_type":"text/plain"}}},"children":[],"identifier":"shor-second-instance-outputs-0","html_id":"shor-second-instance-outputs-0","key":"or0kMfFZFQ"}],"identifier":"shor-second-instance-outputs","html_id":"shor-second-instance-outputs","key":"HBYo0Q0gaO"}],"identifier":"shor-second-instance","html_id":"shor-second-instance","label":"shor-second-instance","key":"oXwOTJow7x"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Real arithmetic access and logical counts","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mnED0ax3A8"}],"identifier":"real-arithmetic-access-and-logical-counts","label":"Real arithmetic access and logical counts","html_id":"real-arithmetic-access-and-logical-counts","implicit":true,"key":"yJ0wLVmxPp"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"A modulus-three arithmetic circuit is compact enough to expand visually. It uses QFT, controlled phases, X/CX and controlled swaps, not an opaque unitary matrix. Counts below include real multiplier construction and uncomputation.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"disssN3jCM"}],"key":"NpRFv6CVGM"}],"identifier":"8642c940","html_id":"8642c940","key":"SCTM2N6A9h"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-14T17:06:59.444482Z","iopub.status.busy":"2026-11-14T17:06:59.443669Z","iopub.status.idle":"2026-11-14T17:06:59.780188Z","shell.execute_reply":"2026-11-14T17:06:59.779319Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"small = QuantumCircuit(7)\nsmall.append(controlled_multiplier_gate(3, 2), range(7))\nsmall.decompose(reps=1).draw(output=\"mpl\", fold=32, scale=0.7)","identifier":"shor-arithmetic-code","enumerator":"6","html_id":"shor-arithmetic-code","key":"CjSWJjGaZs"},{"type":"outputs",