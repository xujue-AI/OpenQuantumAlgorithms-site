{"version":3,"kind":"Article","sha256":"7c35f9eba9b871664bcf81548cff8e175955026e3ad998b3f825b621fbea6a9a","slug":"algorithms.qft-qpe.verification","location":"/algorithms/qft-qpe/verification.md","dependencies":[],"frontmatter":{"title":"QFT and phase estimation: verification","description":"Planned independent transform, phase-distribution, and precision checks.","authors":[{"nameParsed":{"literal":"Open Quantum Algorithms contributors","given":"Open Quantum Algorithms","family":"contributors"},"name":"Open Quantum Algorithms contributors","id":"contributors-myst-generated-uid-0"}],"numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"verification.md","url":"/OpenQuantumAlgorithms-site/_public/verification-d140030c6c7ed7b09389816ecb8319ad.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"strong","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Status: verification plan.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"Ah8gcTMx76"}],"key":"l0CPnq2rhw"},{"type":"text","value":" Results will be linked here after the ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"uCTvgACXgl"},{"type":"link","url":"/algorithms/qft-qpe","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"circuit implementation","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"YopOoKkbOR"}],"urlSource":"../qft-qpe.md","dataUrl":"/algorithms.qft-qpe.json","internal":true,"protocol":"file","key":"VaeZi6byXE"},{"type":"text","value":" is integrated and its checks are run.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"PA9oydZ31m"}],"key":"NgusGcXGzB"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"For a small register, build the reference Fourier matrix directly from its mathematical definition. Compare the circuit with that matrix, check unitarity and inverse behavior, and test both basis states and superpositions. The reference must specify the sign convention and bit-reversal permutation independently of the circuit generator.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"XmRjszEJWj"}],"key":"MirRP2zUMc"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Phase-estimation checks will cover phases exactly representable on the chosen grid and phases between grid points. An explicitly prepared eigenstate supplies a known answer. For a superposition input, compare the full ideal output distribution with the expected eigenphase weights. Controlled powers must agree with independently computed matrix powers in these tiny cases.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"yPjcDE2DQr"}],"key":"ZXDR1Q4iOg"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"An approximate transform needs a declared error metric and tests across its advertised precision range. Numerical agreement at one size does not certify a truncation or synthesis bound. Sampled phase intervals additionally need a stated confidence procedure; deterministic matrix checks cannot validate interval coverage.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"N6aaltxReH"}],"key":"TgTtidgFvx"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Later formal work may connect to ","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"taZ7Gm73Wv"},{"type":"link","url":"https://github.com/inQWIRE/SQIR","p