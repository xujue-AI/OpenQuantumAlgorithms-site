lock","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Optional live controls","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"l7tk38mfIe"}],"identifier":"optional-live-controls","label":"Optional live controls","html_id":"optional-live-controls","implicit":true,"key":"VSpJuRlO7F"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"In a live kernel, select a bounded case to regenerate the actual ripple circuit and its computed probability plot. Static publication omits kernel-backed controls. The live kernel is local or Binder; GitHub Pages needs no maintained server.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Ry96J70lXD"}],"key":"XSvXQ1n3TV"}],"identifier":"c99f0698","html_id":"c99f0698","key":"TSGkQrpDxn"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:24:26.497560Z","iopub.status.busy":"2026-11-15T01:24:26.497402Z","iopub.status.idle":"2026-11-15T01:24:26.501530Z","shell.execute_reply":"2026-11-15T01:24:26.500983Z"},"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def explore_ripple(case):\n    N, a, t = case\n    result = simulate_order_finding_ripple(N, a, t)\n    contract = success_contract(N, a, t)\n    print({\"N\": N, \"a\": a, \"phase_bits\": t, \"wires\": result[\"total_qubits\"], \"distribution_validation_error\": result[\"maximum_probability_error\"], \"ideal_factor_success\": contract[\"ideal_factoring_success_probability_per_trial\"], \"complete_trials\": contract[\"serial_trials\"]})\n    plt.bar(np.arange(1 << t), result[\"probabilities\"], color=\"#287e83\")\n    plt.xlabel(\"Exponent outcome\"); plt.ylabel(\"Ideal probability\"); plt.show()\n    display(build_order_finding_circuit_ripple(N, a, t).draw(output=\"mpl\", fold=36, scale=0.6))\n\nif os.environ.get(\"OPENQUANTUM_STATIC_BUILD\") != \"1\":\n    from IPython.display import display\n    import ipywidgets as widgets\n    widgets.interact(explore_ripple, case=widgets.Dropdown(options={\n        \"N15, a2, t4\": (15, 2, 4),\n        \"N15, a7, t4\": (15, 7, 4),\n        \"N21, a2, t4\": (21, 2, 4),\n        \"N21, a2, t6\": (21, 2, 6),\n    }))","visibility":"show","key":"EcTs5uXVdH"},{"type":"outputs","id":"5YoCodKXRuQEarVLFWJe2","children":[],"visibility":"remove","key":"czfpiHRx8R"}],"identifier":"3d941d94","html_id":"3d941d94","visibility":"show","key":"iSgsqRCY44"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Reproduce and scale separately","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"t7QABGT5om"}],"identifier":"reproduce-and-scale-separately","label":"Reproduce and scale separately","html_id":"reproduce-and-scale-separately","implicit":true,"key":"wMrJnYAwK0"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"inlineCode","value":"python scripts/generate_shor_ripple.py --physical","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ElnqSkRD6u"},{"type":"text","value":" emits real QASM, source hashes, sparse checks, a circuit-only scaling table and a matched conditional surface-code comparison. ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"arbyqx7iAP"},{"type":"inlineCode","value":"--dense-check --no-extra","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zjeypvBXjU"},{"type":"text","value":" optionally repeats the slow full N15 Qiskit check. ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ibjV7D6qq9"},{"type":"inlineCode","value":"--modulus 33 --base 2 --p