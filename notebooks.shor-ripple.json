{"version":3,"kind":"Notebook","sha256":"0315e2d6a403e675c33941618a8f1238b8e9753644f2bbaf91da75c55e85c351","slug":"notebooks.shor-ripple","location":"/notebooks/shor_ripple.ipynb","dependencies":[],"frontmatter":{"title":"Ripple-carry arithmetic for order finding","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"authors":[{"nameParsed":{"literal":"Open Quantum Algorithms contributors","given":"Open Quantum Algorithms","family":"contributors"},"name":"Open Quantum Algorithms contributors","id":"contributors-myst-generated-uid-0"}],"numbering":{"title":{"offset":2}},"exports":[{"format":"ipynb","filename":"shor_ripple.ipynb","url":"/OpenQuantumAlgorithms-site/notebooks/shor_ripple.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This notebook builds an original Cuccaro-style carry chain and actual modular arithmetic. It compares the same N/a/exponent precision with the Fourier implementation. Sparse and Boolean simulations are bounded classical checks; physical results are conditional QDK model projections. Python3.12 and the pinned public code package are required.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VHsdyXQIjV"}],"key":"ZI8q3dBZOl"}],"identifier":"fdccf6ab","html_id":"fdccf6ab","key":"j5PIbaLMHW"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:24:24.172122Z","iopub.status.busy":"2026-11-15T01:24:24.171860Z","iopub.status.idle":"2026-11-15T01:24:24.430122Z","shell.execute_reply":"2026-11-15T01:24:24.429567Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nimport sys, os\nroot = Path.cwd()\nif not (root / \"src\").exists() and (root.parent / \"src\").exists():\n    root = root.parent\nif (root / \"src\").exists():\n    sys.path.insert(0, str(root / \"src\"))\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom qiskit import QuantumCircuit\nfrom qiskit.quantum_info import Statevector\nfrom openquantum.shor import build_order_finding_circuit, decompose, success_contract\nfrom openquantum.shor_ripple import (\n    ripple_adder_gate, controlled_multiplier_gate_ripple,\n    build_order_finding_circuit_ripple, simulate_boolean_batch,\n    sparse_statevector, simulate_order_finding_ripple,\n)","key":"bLqsdV4ybb"},{"type":"outputs","id":"Hh9-nhEs1vZen31Q98PGc","children":[],"key":"MKOehlZovk"}],"identifier":"66cf0535","html_id":"66cf0535","key":"umwm2hxX0s"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"A real two-bit carry circuit","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CQEcjsnrig"}],"identifier":"a-real-two-bit-carry-circuit","label":"A real two-bit carry circuit","html_id":"a-real-two-bit-carry-circuit","implicit":true,"key":"VH3NJjqJUk"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The first two wires hold a, the next two b, and the last the preserved carry input. MAJ propagates carries; reverse UMA restores a and the carry while leaving b+a+carry modulo4. This deliberately simple implementation uses2m Toffolis and4m CNOTs, rather than claiming the paper’s optimized endpoints.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"onUF0ZA5mK"}],"key":"JDrPW3ZFX2"}],"identifier":"a835d8a7","html_id":"a835d8a7","key":"pr2M76Mgnb"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:24:24.431900Z","iopub.status.busy":"2026-11-15T01:24:24.431652Z","iopub.status.idle":"2026-11-15T01:24:24.592072Z","shell.execute_reply":"2026-11-15T01:24:24.591489Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"adder = QuantumCircuit(5)\nadder.append(ripple_adder_gate(2), range(5))\nadder.decompose().draw(output=\"mpl\", fold=32, scale=0.8)","identifier":"shor-ripple-adder-code","enumerator":"1","html_id":"shor-ripple-adder-code","key":"FFkj2xqCSt"},{"type":"outputs","id":"8vmlLmHj1vyyhkYCmSKtp","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":2,"metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"192496113e562fd555e571e04a374a7b","path":"/OpenQuantumAlgorithms-site/_public/192496113e562fd555e571e04a374a7b.png"},"text/plain":{"content":"<Figure size 898.886x361.2 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"shor-ripple-adder-outputs-0","html_id":"shor-ripple-adder-outputs-0","key":"GJZltbvT70"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"192496113e562fd555e571e04a374a7b","path":"/OpenQuantumAlgorithms-site/_public/192496113e562fd555e571e04a374a7b.png"},"text/plain":{"content":"<Figure size 898.886x361.2 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"shor-ripple-adder-outputs-1","html_id":"shor-ripple-adder-outputs-1","key":"PrrlCC4VUy"}],"identifier":"shor-ripple-adder-outputs","html_id":"shor-ripple-adder-outputs","key":"i5j2iw8j1H"}],"identifier":"shor-ripple-adder","html_id":"shor-ripple-adder","label":"shor-ripple-adder","key":"cdfVHFmUOr"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:24:24.593605Z","iopub.status.busy":"2026-11-15T01:24:24.593457Z","iopub.status.idle":"2026-11-15T01:24:24.598242Z","shell.execute_reply":"2026-11-15T01:24:24.597748Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"basis_inputs = [a + (b << 2) + (carry << 4)\n                for a in range(4) for b in range(4) for carry in (0, 1)]\nexpected = [a + (((a+b+carry) % 4) << 2) + (carry << 4)\n            for a in range(4) for b in range(4) for carry in (0, 1)]\nassert simulate_boolean_batch(adder, basis_inputs) == expected\n{\"checked_all_basis_inputs\": len(basis_inputs), \"a_and_carry_restored\": True}","key":"ZszSQQbPBC"},{"type":"outputs","id":"bcOWD4izdP3pQHLgDwNPd","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":3,"metadata":{},"data":{"text/plain":{"content":"{'checked_all_basis_inputs': 32, 'a_and_carry_restored': True}","content_type":"text/plain"}}},"children":[],"key":"I5VLy3qGhp"}],"key":"SItZfLo3vd"}],"identifier":"02069624","html_id":"02069624","key":"vW9pBpTO62"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Actual modular multiplication and coherent control","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aofiMKZQqb"}],"identifier":"actual-modular-multiplication-and-coherent-control","label":"Actual modular multiplication and coherent control","html_id":"actual-modular-multiplication-and-coherent-control","implicit":true,"key":"kXvKotIUEw"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Constant-register preparation is controlled with X/CX/CCX. The ripple adder restores the constant register, which is unprepared before its next use. Borrow cleanup and inverse multiplication are included. The extra work register trades space for fewer general-angle rotations.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"nlyGD6Ib6a"}],"key":"ZkxlOY42AP"}],"identifier":"1fe1b080","html_id":"1fe1b080","key":"sujOQmIGPF"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:24:24.599438Z","iopub.status.busy":"2026-11-15T01:24:24.599304Z","iopub.status.idle":"2026-11-15T01:24:24.982299Z","shell.execute_reply":"2026-11-15T01:24:24.981675Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"N, a, t = 15, 2, 4\nsource = build_order_finding_circuit_ripple(N, a, t)\nsource.draw(output=\"mpl\", fold=36, scale=0.7)","identifier":"shor-ripple-circuit-code","enumerator":"2","html_id":"shor-ripple-circuit-code","key":"itclD3QOzu"},{"type":"outputs","id":"t-6Ar7cbADwSpNSsqfyRt","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"23864f228b6f5a55baded4192325015f","path":"/OpenQuantumAlgorithms-site/_public/23864f228b6f5a55baded4192325015f.png"},"text/plain":{"content":"<Figure size 389.592x1193.97 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"shor-ripple-circuit-outputs-0","html_id":"shor-ripple-circuit-outputs-0","key":"dtQXum8PVE"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"23864f228b6f5a55baded4192325015f","path":"/OpenQuantumAlgorithms-site/_public/23864f228b6f5a55baded4192325015f.png"},"text/plain":{"content":"<Figure size 389.592x1193.97 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"shor-ripple-circuit-outputs-1","html_id":"shor-ripple-circuit-outputs-1","key":"jK3rpVDqSU"}],"identifier":"shor-ripple-circuit-outputs","html_id":"shor-ripple-circuit-outputs","key":"idEURL0EUI"}],"identifier":"shor-ripple-circuit","html_id":"shor-ripple-circuit","label":"shor-ripple-circuit","key":"GLrA7TbNuA"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:24:24.983573Z","iopub.status.busy":"2026-11-15T01:24:24.983419Z","iopub.status.idle":"2026-11-15T01:24:25.061293Z","shell.execute_reply":"2026-11-15T01:24:25.060670Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Actual small complex-state check, independent of the Boolean interpreter.\ngate = controlled_multiplier_gate_ripple(5, 2)\ncoherent = QuantumCircuit(gate.num_qubits)\ncoherent.h(0)\ncoherent.s(0)\ncoherent.x(1)\ncoherent.append(gate, range(gate.num_qubits))\nactual = Statevector.from_instruction(coherent).data\nexpected = np.zeros_like(actual)\nexpected[2], expected[5] = 1/np.sqrt(2), 1j/np.sqrt(2)\nassert np.max(np.abs(actual - expected)) < 1e-13\n{\"maximum_complex_amplitude_error\": float(np.max(np.abs(actual - expected))), \"work_clean_and_relative_phase_preserved\": True}","identifier":"shor-ripple-coherent-code","enumerator":"3","html_id":"shor-ripple-coherent-code","key":"Vjvq4ScZfH"},{"type":"outputs","id":"2FA-UJxd90Ja3tKCFm01d","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{},"data":{"text/plain":{"content":"{'maximum_complex_amplitude_error': 0.0,\n 'work_clean_and_relative_phase_preserved': True}","content_type":"text/plain"}}},"children":[],"identifier":"shor-ripple-coherent-outputs-0","html_id":"shor-ripple-coherent-outputs-0","key":"QOiKoZd6Qb"}],"identifier":"shor-ripple-coherent-outputs","html_id":"shor-ripple-coherent-outputs","key":"qTHtWrzc6R"}],"identifier":"shor-ripple-coherent","html_id":"shor-ripple-coherent","label":"shor-ripple-coherent","key":"t7b7iZYSup"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Full sparse circuit checks","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HuMtPfc3NX"}],"identifier":"full-sparse-circuit-checks","label":"Full sparse circuit checks","html_id":"full-sparse-circuit-checks","implicit":true,"key":"WuxaSnAoFK"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The source simulator applies every H/phase and Boolean primitive to complex amplitudes. It does not substitute a classical modular-power matrix or truncate amplitudes. The independent reference uses classical order only for validation. N21 uses25 source wires, avoiding a dense512MiB amplitude array by sparse support and explicit work caps.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"KubOE1tOK5"}],"key":"ZoRvz7vd0R"}],"identifier":"c64e5a90","html_id":"c64e5a90","key":"OYC1nGcFTS"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:24:25.063535Z","iopub.status.busy":"2026-11-15T01:24:25.063294Z","iopub.status.idle":"2026-11-15T01:24:25.361048Z","shell.execute_reply":"2026-11-15T01:24:25.360429Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"first = simulate_order_finding_ripple(15, 2, 4)\nsecond = simulate_order_finding_ripple(21, 2, 6)\nassert first[\"maximum_probability_error\"] < 1e-10\nassert second[\"maximum_probability_error\"] < 1e-10\nassert first[\"dirty_work_probability\"] == second[\"dirty_work_probability\"] == 0\n[{key: result[key] for key in (\"modulus\", \"total_qubits\", \"maximum_probability_error\", \"dirty_work_probability\", \"peak_nonzero_amplitudes\", \"source_gate_state_applications\")}\n for result in (first, second)]","identifier":"shor-ripple-results-code","enumerator":"4","html_id":"shor-ripple-results-code","key":"vxypuu5Wi7"},{"type":"outputs","id":"Fw8dEEzidYVfv84oG6SMk","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":6,"metadata":{},"data":{"text/plain":{"content":"[{'modulus': 15,\n  'total_qubits': 20,\n  'maximum_probability_error': 3.3306690738754696e-16,\n  'dirty_work_probability': 0.0,\n  'peak_nonzero_amplitudes': 16,\n  'source_gate_state_applications': 45564},\n {'modulus': 21,\n  'total_qubits': 25,\n  'maximum_probability_error': 3.0531133177191805e-16,\n  'dirty_work_probability': 0.0,\n  'peak_nonzero_amplitudes': 380,\n  'source_gate_state_applications': 818384}]","content_type":"text/plain"}}},"children":[],"identifier":"shor-ripple-results-outputs-0","html_id":"shor-ripple-results-outputs-0","key":"mnGWuekLVT"}],"identifier":"shor-ripple-results-outputs","html_id":"shor-ripple-results-outputs","key":"dffaU7stwf"}],"identifier":"shor-ripple-results","html_id":"shor-ripple-results","label":"shor-ripple-results","key":"LGbj6Zi7Np"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:24:25.362707Z","iopub.status.busy":"2026-11-15T01:24:25.362535Z","iopub.status.idle":"2026-11-15T01:24:25.479386Z","shell.execute_reply":"2026-11-15T01:24:25.478844Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"plt.bar(np.arange(1 << 6), second[\"probabilities\"], color=\"#287e83\", label=\"actual ripple circuit\")\nplt.plot(np.arange(1 << 6), second[\"reference_probabilities\"], \".\", color=\"#d8794f\", label=\"independent Fourier/order sum\")\nplt.xlabel(\"Exponent outcome: N21, a2, t6\")\nplt.ylabel(\"Ideal probability\")\nplt.legend(); plt.tight_layout(); plt.show()","identifier":"shor-ripple-probabilities-code","enumerator":"5","html_id":"shor-ripple-probabilities-code","key":"Y0ze04mdmE"},{"type":"outputs","id":"sG8XccqS0rtO-clVHo7Va","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"b6e4439d2242544c2e2f08ab40e5879f","path":"/OpenQuantumAlgorithms-site/_public/b6e4439d2242544c2e2f08ab40e5879f.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"shor-ripple-probabilities-outputs-0","html_id":"shor-ripple-probabilities-outputs-0","key":"MOnDyeKgCD"}],"identifier":"shor-ripple-probabilities-outputs","html_id":"shor-ripple-probabilities-outputs","key":"V3DNg7Or9H"}],"identifier":"shor-ripple-probabilities","html_id":"shor-ripple-probabilities","label":"shor-ripple-probabilities","key":"IF9tsSoWZ2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Equal-task logical comparison","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FilxT1qgRG"}],"identifier":"equal-task-logical-comparison","label":"Equal-task logical comparison","html_id":"equal-task-logical-comparison","implicit":true,"key":"F1N97Lplis"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Both circuits use the same classical input, initial modular value1, exponent precision and readout rule. Counts include all work registers, constant handling, inverses, state preparation and final measurements. More total gates can still mean fewer synthesized rotations; a physical comparison requires its own matched model.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xywHW5IPvj"}],"key":"nQLcmgmzNA"}],"identifier":"137f892d","html_id":"137f892d","key":"WJR2dG0ps8"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:24:25.481034Z","iopub.status.busy":"2026-11-15T01:24:25.480777Z","iopub.status.idle":"2026-11-15T01:24:26.496100Z","shell.execute_reply":"2026-11-15T01:24:26.495493Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"rows = []\nfor N, a, t in [(15, 2, 4), (21, 2, 6)]:\n    trials = success_contract(N, a, t)[\"serial_trials\"]\n    for name, builder in [(\"Fourier\", build_order_finding_circuit), (\"ripple\", build_order_finding_circuit_ripple)]:\n        compiled = decompose(builder(N, a, t, measure=True))\n        rows.append({\"N\": N, \"a\": a, \"t\": t, \"method\": name,\n                     \"logical_qubits\": compiled.num_qubits, \"primitive_operations\": int(sum(compiled.count_ops().values())),\n         