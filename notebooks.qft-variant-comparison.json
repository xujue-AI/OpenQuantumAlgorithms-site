{"version":3,"kind":"Notebook","sha256":"14541fbb0105d9099e7e4d8f02431947df0ec7155c78494b5284433cb56e21ac","slug":"notebooks.qft-variant-comparison","location":"/notebooks/qft_variant_comparison.ipynb","dependencies":[],"frontmatter":{"title":"Exact versus approximate inverse QFT in phase estimation","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"authors":[{"nameParsed":{"literal":"Open Quantum Algorithms contributors","given":"Open Quantum Algorithms","family":"contributors"},"name":"Open Quantum Algorithms contributors","id":"contributors-myst-generated-uid-0"}],"numbering":{"title":{"offset":2}},"exports":[{"format":"ipynb","filename":"qft_variant_comparison.ipynb","url":"/OpenQuantumAlgorithms-site/notebooks/qft_variant_comparison.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The output task is a ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qRCMVW7AcC"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"scalar median phase estimate","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"d415GRjCSV"}],"key":"ULe5hFBhy4"},{"type":"text","value":", rather than a Fourier-state measurement with no inference contract. The prepared phase is 0.3, target width one, requested absolute phase error 2⁻ᵐ and whole-run failure target 1%. Every complete trial has fresh preparation, all repeated controlled-U calls, retained inverse-QFT gates and final phase measurements.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YiZMwcTomc"}],"key":"I16gy3clHv"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The predeclared physical comparison uses m=5,6,7, exact cutoff m−1 versus one omitted longest-distance phase m−2, synthesis-model allowances 10⁻⁴/10⁻⁵ and two frozen physical profiles. Known-phase preparation makes this a correctness/resource example, without an application-speedup claim.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"DlYTwuKc5l"}],"key":"Yb9RkoFqys"}],"identifier":"2425bbd9","html_id":"2425bbd9","key":"xHeHor4OqD"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:23:19.784920Z","iopub.status.busy":"2026-11-15T01:23:19.784705Z","iopub.status.idle":"2026-11-15T01:23:20.643240Z","shell.execute_reply":"2026-11-15T01:23:20.642625Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nimport sys, os, math, csv, json\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom IPython.display import display, SVG\nroot=Path.cwd()\nif not (root/\"src\").exists() and (root.parent/\"src\").exists():\n    root=root.parent\nif (root/\"src\").exists():sys.path.insert(0,str(root/\"src\"))\nfrom openquantum.approximate_qft_resources import (\n    QPEVariantContract, build_contract_trial, checked_distribution,\n    fixed_grid, majority_failure_upper,\n)\nfrom openquantum.qft_qpe import qpe_distribution\nfrom openquantum.resource_estimation import prepare_measured_circuit\noutput=root/\"assets/generated/qft-variant-comparison\"\nselected=QPEVariantContract(5,3,synthesis_model_allowance_per_trial=1e-5)\nsource=build_contract_trial(selected,measure=True)\ncompiled=prepare_measured_circuit(source)\nprint({\"phase\":selected.phase,\"phase_error_target\":selected.phase_error_target,\n       \"cutoff\":selected.max_distance,\"fresh_trials\":selected.repetitions,\n       \"omission_output_tv_upper\":float(selected.omission_output_tv_upper),\n       \"synthesis_model_allowance_per_trial\":selected.synthesis_model_allowance_per_trial,\n       \"statistical_failure_allowance\":float(selected.statistical_failure_allowance),\n       \"physical_failure_allowance_all_trials\":selected.physical_failure_allowance})","key":"C0Kd2q90da"},{"type":"outputs","id":"yPOL1at0RuMWG6BaI-4KT","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"{'phase': 0.3, 'phase_error_target': 0.03125, 'cutoff': 3, 'fresh_trials': 127, 'omission_output_tv_upper': 0.19642857142857142, 'synthesis_model_allowance_per_trial': 1e-05, 'statistical_failure_allowance': 0.0049, 'physical_failure_allowance_all_trials': 0.005}\n"},"children":[],"key":"Sdlfd1jRCQ"}],"key":"EHpqSF5Ry9"}],"identifier":"1c9d08fb","html_id":"1c9d08fb","key":"xgcIns6aO3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Actual complete truncated trial","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"G6Zku27mKY"}],"identifier":"actual-complete-truncated-trial","label":"Actual complete truncated trial","html_id":"actual-complete-truncated-trial","implicit":true,"key":"t4JO8SEoIb"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The cutoff keeps every Hadamard and final swap. Only the longest-distance inverse-QFT controlled phase is omitted. The phase-gate U is implemented and repeated 2ᵐ−1 times; powers are not free oracles.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"UwjyAKvSTx"}],"key":"CVIOb9UVdZ"}],"identifier":"093abc02","html_id":"093abc02","key":"o2hPUcI4Qx"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:23:20.645438Z","iopub.status.busy":"2026-11-15T01:23:20.645086Z","iopub.status.idle":"2026-11-15T01:23:20.927092Z","shell.execute_reply":"2026-11-15T01:23:20.926455Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"display(source.draw(output=\"mpl\",fold=36,style=\"iqp\"))\nplt.close(\"all\")","identifier":"qft-variant-truncated-circuit-code","enumerator":"1","html_id":"qft-variant-truncated-circuit-code","key":"DUGrFIhtyk"},{"type":"outputs","id":"MlBfY4HCureNNS7YhKC_4","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"704bfa4d9c364a5fdd651476f96a482f","path":"/OpenQuantumAlgorithms-site/_public/704bfa4d9c364a5fdd651476f96a482f.png"},"text/plain":{"content":"<Figure size 3130.27x1287.61 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"qft-variant-truncated-circuit-outputs-0","html_id":"qft-variant-truncated-circuit-outputs-0","key":"GqjzYvdPA3"}],"identifier":"qft-variant-truncated-circuit-outputs","html_id":"qft-variant-truncated-circuit-outputs","key":"ZbzTmA80LD"}],"identifier":"qft-variant-truncated-circuit","html_id":"qft-variant-truncated-circuit","label":"qft-variant-truncated-circuit","key":"y2Pys8S9QU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Omission and confidence have different units","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OCgHDsq5tH"}],"identifier":"omission-and-confidence-have-different-units","label":"Omission and confidence have different units","html_id":"omission-and-confidence-have-different-units","implicit":true,"key":"dGkgS6lTZC"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The ideal spectral omission bound η controls worst-case output-distribution total variation. It changes a bound on ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PJ28eSivFf"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"single-trial bad-output probability","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"NFuQG3MlTV"}],"key":"Hq0PXcGI2e"},{"type":"text","value":", not the numerical phase tolerance. The conservative allocation uses π<22/7: base bad probability is at most 23/121, plus rational dyadic omission bound plus the synthesis-TV model allowance.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fkis3GpEQG"}],"key":"l3WjFSV8C0"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Exact Fraction binomial tails select the least odd number of fresh trials whose majority failure is at most 0.0049. Physical faults use a separate 0.005 whole-run allowance. The same requested error 2⁻ᵐ remains in each exact/truncated pair. Hardware confidence, binary64 phase enclosures and concrete synthesis/runtime tails are not certified.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"bkBBUH9GtB"}],"key":"rqeHBepVQQ"}],"identifier":"0c1c190d","html_id":"0c1c190d","key":"VQMTY7m75Y"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:23:20.928441Z","iopub.status.busy":"2026-11-15T01:23:20.928293Z","iopub.status.idle":"2026-11-15T01:23:23.239454Z","shell.execute_reply":"2026-11-15T01:23:23.238938Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"rows=[]\nfor m in [5,6,7]:\n    for cutoff in [m-1,m-2]:\n        contract=QPEVariantContract(m,cutoff,synthesis_model_allowance_per_trial=1e-5)\n        trial=build_contract_trial(contract)\n        actual=checked_distribution(trial,m)\n        exact=qpe_distribution(.3,m)\n        tv=.5*float(np.abs(actual-exact).sum())\n        assert tv<=float(contract.omission_output_tv_upper)+3e-12\n        if cutoff==m-1:assert np.max(np.abs(actual-exact))<3e-12\n        measured=build_contract_trial(contract,measure=True)\n        primitive=prepare_measured_circuit(measured)\n        count=sum(value for name,value in primitive.count_ops().items() if name!=\"barrier\")\n        tail=majority_failure_upper(contract.single_trial_failure_upper,contract.repetitions)\n        assert tail<=contract.statistical_failure_allowance\n        rows.append({\"m\":m,\"variant\":\"exact\" if cutoff==m-1 else \"truncated\",\n                     \"phase_error_target\":contract.phase_error_target,\n                     \"observed_output_TV\":tv,\"omission_TV_upper\":float(contract.omission_output_tv_upper),\n                     \"fresh_trials\":contract.repetitions,\"operations_per_trial\":count,\n                     \"operations_all_trials\":count*contract.repetitions,\n                     \"all_controlled_U_calls\":(2**m-1)*contract.repetitions,\n                     \"all_input_preparations\":contract.repetitions,\"all_phase_readouts\":m*contract.repetitions,\n                     \"majority_failure_upper\":float(tail)})\ndisplay(rows)","identifier":"qft-variant-budget-table-code","enumerator":"2","html_id":"qft-variant-budget-table-code","key":"YZnXnhli3v"},{"type":"outputs","id":"hxzHbVoOXnP0m2_QyH8hh","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"[{'m': 5,\n  'variant': 'exact',\n  'phase_error_target': 0.03125,\n  'observed_output_TV': 2.083511314865394e-15,\n  'omission_TV_upper': 0.0,\n  'fresh_trials': 15,\n  'operations_per_trial': 227,\n  'operations_all_trials': 3405,\n  'all_controlled_U_calls': 465,\n  'all_input_preparations': 15,\n  'all_phase_readouts': 75,\n  'majority_failure_upper': 0.0030376981264813095},\n {'m': 5,\n  'variant': 'truncated',\n  'phase_error_target': 0.03125,\n  'observed_output_TV': 0.009072406528621704,\n  'omission_TV_upper': 0.19642857142857142,\n  'fresh_trials': 127,\n  'operations_per_trial': 222,\n  'operations_all_trials': 281