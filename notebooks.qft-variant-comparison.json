0","key":"IwagwC0US4"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/svg+xml":{"content_type":"image/svg+xml","hash":"3525f1d27022b4c3f5dcb5f0b7f44b84","path":"/OpenQuantumAlgorithms-site/_public/3525f1d27022b4c3f5dcb5f0b7f44b84.svg"},"text/plain":{"content":"<IPython.core.display.SVG object>","content_type":"text/plain"}}},"children":[],"identifier":"qft-variant-physical-comparison-outputs-1","html_id":"qft-variant-physical-comparison-outputs-1","key":"CMCERxELWG"}],"identifier":"qft-variant-physical-comparison-outputs","html_id":"qft-variant-physical-comparison-outputs","key":"LYGuFUBRUR"}],"identifier":"qft-variant-physical-comparison","html_id":"qft-variant-physical-comparison","label":"qft-variant-physical-comparison","key":"vwdHaWl5b1"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The computed predeclared grid saves five primitive operations per trial after lowering. The conservative omission allowance needs 127/35/21 fresh trials at m=5/6/7, compared with 15 exact trials. Here the added trials outweigh the gate saving. This scoped result does not rule out improvement under a sharper independently established application-specific omission/inference contract.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YCXsuaw3M5"}],"key":"obaS2j3l28"}],"identifier":"9201437c","html_id":"9201437c","key":"x4cVWVX0ds"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Optional bounded live controls","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AWYNB0M62U"}],"identifier":"optional-bounded-live-controls","label":"Optional bounded live controls","html_id":"optional-bounded-live-controls","implicit":true,"key":"aP1UhVmkII"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Controls regenerate actual circuits and check the omission-TV bound. The saved physical reports apply only to the predeclared phase 0.3; changing the phase below does not reuse those estimates. Static reading requires no kernel backend.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"eXZYc7TjF8"}],"key":"A1AVo1bR8h"}],"identifier":"628e6980","html_id":"628e6980","key":"TowTRd7DPB"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:23:23.694621Z","iopub.status.busy":"2026-11-15T01:23:23.694476Z","iopub.status.idle":"2026-11-15T01:23:23.698907Z","shell.execute_reply":"2026-11-15T01:23:23.698271Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"if os.environ.get(\"OPENQUANTUM_STATIC_BUILD\") != \"1\":\n    import ipywidgets as widgets\n    def explore(m=5,phase=.3):\n        exact_contract=QPEVariantContract(m,m-1,phase=phase)\n        truncated_contract=QPEVariantContract(m,m-2,phase=phase)\n        a=checked_distribution(build_contract_trial(exact_contract),m)\n        b=checked_distribution(build_contract_trial(truncated_contract),m)\n        tv=.5*float(np.abs(a-b).sum())\n        assert tv<=float(truncated_contract.omission_output_tv_upper)+3e-12\n        print({\"phase\":phase,\"m\":m,\"observed_output_TV\":tv,\n               \"omission_TV_upper\":float(truncated_contract.omission_output_tv_upper),\n               \"exact_trials\":exact_contract.repetitions,\"truncated_trials\":truncated_contract.repetitions,\n               \"physical_results_reused\":False})\n    widgets.interact(explore,m=widgets.Dropdown(options=[5,6,7],value=5),\n                     phase=widgets.Dropdown(options=[.125,.3,.5,.7,.875],value=.3))\nelse:\n    print(\"Saved bounded outputs; launch a live kernel for controls.\")","key":"usuOMWjeU6"},{"type":"outputs","id":"iE1nCnLVIxHN0RFPbLBal","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Saved bounded outputs; launch a live kernel for controls.\n"},"children":[],"key":"dWxF0t6ZpB"}],"key":"rclTyc7y3z"}],"identifier":"b6f9d4f3","html_id":"b6f9d4f3","key":"EkE5pdztNf"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Reproduce and inspect","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MjPyZE5Q7v"}],"identifier":"reproduce-and-inspect","label":"Reproduce and inspect","html_id":"reproduce-and-inspect","implicit":true,"key":"uvg0eBKKlu"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Use Python 3.12 and the locked environment from the public source package:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Gi9KIuv7Rk"}],"key":"VsceFrVA0K"},{"type":"code","lang":"bash","value":"python scripts/generate_qft_variant_comparison.py --estimate\npython -m pytest tests/test_approximate_qft_resources.py","position":{"start":{"line":5,"column":1},"end":{"line":8,"column":1}},"key":"EauXvFT34U"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Qiskit core constructs and simulates actual gates; NumPy supplies independent reference arithmetic; Matplotlib supplies original figures. The spectral omission construction follows the approximate-QFT framework cited by the parent chapter. No Lean proof or certified hardware implementation is integrated.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"AbtyAvPgqI"}],"key":"i7SeNTYInO"}],"identifier":"3de49f90","html_id":"3de49f90","key":"Yyv9sqAJY2"}],"key":"yVGjGdePL8"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Approximate Fourier transform","short_title":"Approximate QFT","url":"/algorithms/qft-qpe/approximate-qft","group":"Open Quantum Algorithms"},"next":{"title":"Iterative phase estimation with feedback","short_title":"Feedback phase estimation","url":"/algorithms/qft-qpe/iterative","group":"Open Quantum Algorithms"}}},"domain":"http://pre.render"}