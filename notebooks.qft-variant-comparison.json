\")\naxis.set(xlabel=\"Decoded phase y / 32\",ylabel=\"Ideal single-trial probability\")\naxis.legend();fig.tight_layout();display(fig);plt.close(fig)","identifier":"qft-variant-distributions-code","enumerator":"3","html_id":"qft-variant-distributions-code","key":"TFnZf8TPy2"},{"type":"outputs","id":"gHAEgHYKVIXOqfaEc7zAc","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"9e1d244e9090991bfc9a9e6e263ba340","path":"/OpenQuantumAlgorithms-site/_public/9e1d244e9090991bfc9a9e6e263ba340.png"},"text/plain":{"content":"<Figure size 800x330 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"qft-variant-distributions-outputs-0","html_id":"qft-variant-distributions-outputs-0","key":"znaU4IVCjx"}],"identifier":"qft-variant-distributions-outputs","html_id":"qft-variant-distributions-outputs","key":"MsR00t0WIH"}],"identifier":"qft-variant-distributions","html_id":"qft-variant-distributions","label":"qft-variant-distributions","key":"waCzbWw6AL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Conditional physical comparison","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NbXJbJJwKy"}],"identifier":"conditional-physical-comparison","label":"Conditional physical comparison","html_id":"conditional-physical-comparison","implicit":true,"key":"trqO95siEB"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The separate generator estimates every complete measured trial and charges all fresh trials. Both hardware profiles keep 100 ns gates and 500 ns measurements, at physical errors 10⁻³/10⁻⁴. Synthesis allowances remain per output; physical faults are divided over the full repetition count.","position":{"start":{"line":3,"column"