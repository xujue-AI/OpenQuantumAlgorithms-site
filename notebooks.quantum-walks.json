":[{"type":"code","lang":"python","executable":true,"value":"budget=coined_observable_budget()\nct_budget=continuous_observable_budget(synthesis_bias=1e-4)\nassert budget.shots_required==ct_budget.shots_required==3329\nmeasured=lower_walk(build_coined_walk(3,4,measure=True))\nprint(\"Complete trial qubits:\",measured.num_qubits)\nprint(\"Primitive gates/readouts per trial:\",dict(measured.count_ops()))\nprint(\"Dependency depth (not hardware runtime):\",measured.depth())\nprint(\"All3329-trial operation count:\",len(measured.data)*budget.shots_required)\ncounts=sample_position_outcomes(result[\"probabilities\"],budget.shots_required,seed=731)\nprint(\"Seeded classical categorical counts from the ideal marginal:\",counts)\nprint(\"Sampled return mean:\",counts[0]/counts.sum())\nprint(\"Certified confidence:\",budget.as_contract()[\"certified_confidence_lower_bound\"])\nreport=root/\"assets/generated/quantum-walks/surface-code-scaling.json\"\nif report.exists():\n    data=json.loads(report.read_text())\n    print(\"Conditional physical queries recorded:\",data[\"query_count\"])\nelse:\n    print(\"Physical queries are separate optional artifacts; this notebook does not require QDK.\")","identifier":"walk-resource-ledger-code","enumerator":"7","html_id":"walk-resource-ledger-code","key":"fdql3xxQnF"},{"type":"outputs","id":"rvFOqoUyPJg_vffQgpmCT","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Complete trial qubits: 4\nPrimitive gates/readouts per trial: {'cx': 160, 'rz': 124, 't': 28, 'tdg': 24, 'h': 10, 'x': 5, 'measure': 4, 'ry': 3, 'rx': 1}\nDependency depth (not hardware runtime): 294\nAll3329-trial operation count: 1195111\nSeeded classical categorical counts from the ideal marginal: [ 399    0 1233    0  432    0 1265    0]\nSampled return mean: 0.11985581255632322\nCertified confidence: None\nConditional physical queries recorded: 24\n"},"children":[],"identifier":"walk-resource-ledger-outputs-0","html_id":"walk-resou