k(position_bits,step_count)\n        p=np.arange(1<<position_bits)\n        figure,axis=plt.subplots(figsize=(7,3.3))\n        axis.bar(p,check[\"probabilities\"])\n        axis.set(xlabel=\"Position\",ylabel=\"Quantum probability\",title=f\"{1<<position_bits} vertices, {step_count} steps\")\n        figure.tight_layout();display(figure)\n        print(\"Independent recurrence residual:\",check[\"independent_amplitude_recurrence_max_error\"])\n    display(widgets.interactive(explore,\n        position_bits=widgets.IntSlider(value=3,min=2,max=5,continuous_update=False),\n        step_count=widgets.IntSlider(value=4,min=0,max=16,continuous_update=False)))\nelse:\n    print(\"Live controls omitted in static execution.\")","key":"Pp4YypcfBy"},{"type":"outputs","id":"lF_MndQGBS7Sw7G6OBqVZ","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Live controls omitted in static execution.\n"},"children":[],"key":"N91GqB5nHv"}],"key":"Y552yEb2Wi"}],"identifier":"029f5d38","html_id":"029f5d38","key":"RmBCZTihuE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Reproduce and generate separately from simulation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"K6PovVORlU"}],"identifier":"reproduce-and-generate-separately-from-simulation","label":"Reproduce and generate separately from simulation","html_id":"reproduce-and-generate-separately-from-simulation","implicit":true,"key":"sWxlH28iKe"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Use the pinned Python3.12 environment and public code package. Canonical artifacts: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"H68D8PCBzI"},{"type":"inlineCode","value":"python scripts/generate_quantum_walks.py --estimate","p