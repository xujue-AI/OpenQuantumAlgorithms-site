ta=widgets.FloatSlider(min=0, max=5, step=.25, value=1.25)))","key":"qY9LKafG70"},{"type":"outputs","id":"JVSi2L875i9DtRCK7qnUl","children":[],"key":"ViAI8ececu"}],"identifier":"82354462","html_id":"82354462","key":"nufx916kbI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Scale and precision limits","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Rv1s005UuQ"}],"identifier":"scale-and-precision-limits","label":"Scale and precision limits","html_id":"scale-and-precision-limits","implicit":true,"key":"QsImqfrrFp"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Explicit coefficient loading permits at most eight system qubits (and eight reference qubits), while dense circuit/reference validation stops at six system qubits. The product of inverse temperature and energy range is at most 700, keeping the declared floating weight-loading domain explicit. Circuit generation does not demonstrate an efficient large-system Gibbs algorithm. General Hamiltonians, scalable filtering/mixing, certified rotation synthesis and physical-resource estimates remain planned.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HnADos9eZ3"}],"key":"WqJbb69rNI"}],"identifier":"c13629fe","html_id":"c13629fe","key":"cACQ5aZjGL"}],"key":"toild2mSTn"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Thermal and Gibbs state preparation","short_title":"Gibbs-state preparation","url":"/algorithms/simulation/gibbs-preparation","group":"Open Quantum Algorithms"},"next":{"title":"Noncommuting thermal filtering","url":"/algorithms/simulation/thermal-filter","group":"Open Quantum Algorithms"}}},"domain":"http://pre.render"}