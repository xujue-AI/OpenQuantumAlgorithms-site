n":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Specify the task","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"Nu0Pxcpb7B"}],"identifier":"specify-the-task","label":"Specify the task","html_id":"specify-the-task","implicit":true,"key":"wjTwJZybXG"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"For a transform, record register width, forward/inverse convention, and an operator approximation target. For phase estimation, record the implemented unitary, requested phase precision, failure probability, and how the input eigenstate is prepared. If the input is a superposition of eigenstates, its overlap with the desired eigenstate affects the probability of a useful output and must enter repetition accounting.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"vfkCU9tuN9"}],"key":"UFneZL6Qp0"},{"type":"heading","depth":2,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Charge the complete circuit","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"E5t2UiIHkg"}],"identifier":"charge-the-complete-circuit","label":"Charge the complete circuit","html_id":"charge-the-complete-circuit","implicit":true,"key":"X56GbGLDAD"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Count preparation, controlled powers of the unitary, inverse Fourier processing, ancillas, measurements, and classical phase interpretation. Powers represented by a high-level gate still require an actual implementation. Approximate Fourier transforms must state which rotations are removed and justify the associated error. Remaining arbitrary rotations need their own synthesis allowance.","position":{"start":{"line":14,"column":1},"end":{"line":14,"colum